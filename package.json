{
  "name": "blockyard",
  "version": "0.9.0",
  "private": true,
  "description": "Live web monitor, 3D block-space viewer, block explorer and markets view for a Bitcoin Core node",
  "license": "Apache-2.0",
  "keywords": [
    "bitcoin",
    "node",
    "monitor",
    "mempool",
    "block-explorer",
    "dashboard"
  ],
  "homepage": "https://github.com/BobClawblaw/blockyard#readme",
  "bugs": {
    "url": "https://github.com/BobClawblaw/blockyard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BobClawblaw/blockyard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "server/main.js",
  "scripts": {
    "start": "node server/main.js",
    "dev": "BLOCKYARD_CONFIG=none BLOCKYARD_BIND=127.0.0.1 BLOCKYARD_PORT=18088 BLOCKYARD_FAKE_NODE=1 node server/main.js",
    "fake-node": "node scripts/fake-node.js",
    "user": "node scripts/manage-users.js",
    "test": "node --test \"test/**/*.test.js\"",
    "counts": "node scripts/doc-counts.js",
    "counts:check": "node scripts/doc-counts.js --check",
    "counts:fix": "node scripts/doc-counts.js --fix",
    "smoke": "bash scripts/smoke.sh",
    "render:live": "node scripts/live-render-check.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
